# Classification: INTERNAL (this template holds no real values)
# Copy to .env and fill in locally. Never commit .env.

# --- NetBox target ---
# Must be https:// unless the host is loopback. For a local netbox-docker instance,
# http://localhost:8000/ is accepted and shows a development banner.
NETBOX_URL=https://netbox.example.internal/
NETBOX_TOKEN=<YOUR_NETBOX_API_TOKEN>
# Set to false only against a lab instance with a self-signed certificate.
NETBOX_VERIFY_SSL=true
NETBOX_TIMEOUT=30
# Supported NetBox range is >=4.6,<4.7; the app refuses to import outside it.

# --- Django ---
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=<GENERATE_WITH_get_random_secret_key>
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# This app serves 8080, not Django's usual 8000: port 8000 is the local NetBox.
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# Session and CSRF cookies are secure-only unless this is false. Set false only when running
# the development server over plain http on your own machine.
DJANGO_SERVED_OVER_TLS=false
# Set once the app itself is served over TLS behind a proxy.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0

# --- Import behaviour defaults (see .kiro/specs/netbox-bulk-provisioning/design.md) ---
# Fallback device role slug applied when the sheet omits one.
NETBOX_DEFAULT_DEVICE_ROLE=unassigned
# Allow the importer to create missing manufacturers / device types.
NETBOX_AUTOCREATE_DEVICE_TYPES=false
# Allow a cabling row to create a device interface NetBox does not have: from the device type's
# interface template where one of that name exists, and from the sheet's a_interface_type /
# b_interface_type otherwise. Off by default because the tool cannot tell a new port from a
# mistyped one, and a cabling sheet names two ports per row. With it on, every interface the plan
# would create is a warning the operator has to acknowledge before applying.
NETBOX_AUTOCREATE_INTERFACES=false
# Rack naming convention: <datacenter_slug>-<datahall_slug>-<rack>. The delimiter is also the one
# character a datacenter or datahall slug may not contain, since the name is split on it.
RACK_NAME_DELIMITER=-
MAX_UPLOAD_MB=5
# A validated plan goes stale after this many minutes and must be re-validated (requirement 10.15).
PLAN_EXPIRY_MINUTES=30
# Apply runs inline in the request, so a file above this row count is blocked with advice to
# split it rather than timing out mid-run (requirement 15.3).
MAX_APPLY_ROWS=2000
# Issues rendered in the browser before the list is truncated; the CSV download is never truncated.
MAX_ISSUES_DISPLAYED=500

